<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>$(ShalltearTargetFramework)</TargetFramework>
		<RuntimeFrameworkVersion>$(ShalltearRuntimeVersion)</RuntimeFrameworkVersion>
		<RollForward>Disable</RollForward>
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>
		<RootNamespace>Shalltear</RootNamespace>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<IsAotCompatible>true</IsAotCompatible>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Shalltear.Conformance" />
		<InternalsVisibleTo Include="Shalltear.ConformanceAOT" />
		<InternalsVisibleTo Include="Shalltear.Conformance.Audio" />
		<InternalsVisibleTo Include="Shalltear.ConformanceAudioAOT" />
		<InternalsVisibleTo Include="GameScripts" />
		<InternalsVisibleTo Include="Shalltear.Physics3D" />
		<InternalsVisibleTo Include="Shalltear.Audio" />
		<InternalsVisibleTo Include="Shalltear.Animation" />
	</ItemGroup>
</Project>
