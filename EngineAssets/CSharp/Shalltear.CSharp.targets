<Project>
	<PropertyGroup Condition="'$(ShalltearPlayerBuild)' == 'true'">
		<PublishAot>true</PublishAot>
		<NativeLib>Shared</NativeLib>
		<SelfContained>true</SelfContained>
		<DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
		<InvariantGlobalization Condition="'$(InvariantGlobalization)' == ''">true</InvariantGlobalization>
		<EnableSourceLink>false</EnableSourceLink>
		<DebuggerSupport>false</DebuggerSupport>
		<EventSourceSupport>false</EventSourceSupport>
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>
		<UseSystemResourceKeys>true</UseSystemResourceKeys>
		<TrimmerSingleWarn>false</TrimmerSingleWarn>
	</PropertyGroup>

	<ItemGroup Condition="'$(ShalltearPlayerBuild)' == 'true'">
		<RuntimeHostConfigurationOption Include="Shalltear.LogOrigins" Value="false" Trim="true" />
	</ItemGroup>

	<PropertyGroup Condition="'$(ShalltearPlayerBuild)' == 'true' and '$(Configuration)' == 'Release'">
		<StackTraceSupport>false</StackTraceSupport>
		<IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
	</PropertyGroup>
	<ItemGroup Condition="'$(ShalltearPlayerBuild)' == 'true' and '$(Configuration)' == 'Release'">
		<RuntimeHostConfigurationOption Include="Shalltear.ThreadChecks" Value="false" Trim="true" />
	</ItemGroup>

	<PropertyGroup Condition="'$(ShalltearPlayerBuild)' == 'true' and $(RuntimeIdentifier.StartsWith('win')) and '$(ShalltearWindowsLinker)' != 'VisualStudio'">
		<ShalltearBundledLinker>true</ShalltearBundledLinker>
		<IlcUseEnvironmentalTools>true</IlcUseEnvironmentalTools>
	</PropertyGroup>

	<ItemGroup Condition="'$(ShalltearPlayerBuild)' == 'true' and $(RuntimeIdentifier.StartsWith('win'))">
		<LinkerArg Include="/PDBALTPATH:%25_PDB%25" />
	</ItemGroup>

	<PropertyGroup Condition="'$(ShalltearPlayerBuild)' == 'true'">
		<ShalltearRenamerPath Condition="'$(ShalltearRenamerPath)' == ''">$(ShalltearManagedDir)Renamer/Shalltear.Renamer.dll</ShalltearRenamerPath>
		<ShalltearRenameRoot Condition="'$(ShalltearRenameRoot)' == ''">$(BaseIntermediateOutputPath)rename/</ShalltearRenameRoot>
	</PropertyGroup>

	<Target Name="ShalltearRenameScripts" BeforeTargets="WriteIlcRspFileForCompilation"
			Condition="'$(ShalltearPlayerBuild)' == 'true' and '$(ShalltearRenameScripts)' == 'true'">
		<Error Condition="!Exists('$(ShalltearRenamerPath)')" Text="Shalltear.Renamer.dll was not found at '$(ShalltearRenamerPath)'. Set ShalltearRenamerPath (or ShalltearRenameScripts=false)" />
		<ItemGroup>
			<_ShalltearRenameInput Include="@(IlcCompileInput)" />
		</ItemGroup>
		<RemoveDir Directories="$(ShalltearRenameRoot)" />
		<MakeDir Directories="$(ShalltearRenameRoot)" />
		<WriteLinesToFile File="$(ShalltearRenameRoot)references.txt" Lines="@(IlcReference)" Overwrite="true" />
		<Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(ShalltearRenamerPath)&quot; --out &quot;$(ShalltearRenameRoot)assemblies&quot; --map &quot;$(ShalltearRenameRoot)GameScripts.map&quot; --report &quot;$(ShalltearRenameRoot)report.txt&quot; --refs-file &quot;$(ShalltearRenameRoot)references.txt&quot; --replaced &quot;$(ShalltearRenameRoot)replaced.txt&quot; --copies &quot;$(ShalltearRenameRoot)copies.txt&quot; @(ShalltearRenameAssembly->'--rename &quot;%(Identity)&quot;', ' ') @(_ShalltearRenameInput->'&quot;%(FullPath)&quot;', ' ')"
			  StandardOutputImportance="low" />
		<ReadLinesFromFile File="$(ShalltearRenameRoot)replaced.txt">
			<Output TaskParameter="Lines" ItemName="_ShalltearRenameReplaced" />
		</ReadLinesFromFile>
		<ReadLinesFromFile File="$(ShalltearRenameRoot)copies.txt">
			<Output TaskParameter="Lines" ItemName="_ShalltearRenameCopies" />
		</ReadLinesFromFile>
		<ItemGroup>
			<IlcCompileInput Remove="@(IlcCompileInput)" />
			<IlcCompileInput Include="@(_ShalltearRenameInput->'$(ShalltearRenameRoot)assemblies/%(Filename)%(Extension)')" />
			<IlcReference Remove="@(_ShalltearRenameReplaced)" />
			<IlcReference Include="@(_ShalltearRenameCopies)" />
		</ItemGroup>
	</Target>

	<Target Name="ShalltearCopyRuntimeNotices" AfterTargets="Publish" Condition="'$(ShalltearPlayerBuild)' == 'true'">
		<PropertyGroup>
			<_ShalltearRuntimePack>$([System.IO.Path]::GetFullPath('$(IlcFrameworkNativePath)../../../'))</_ShalltearRuntimePack>
		</PropertyGroup>
		<Error Condition="!Exists('$(_ShalltearRuntimePack)THIRD-PARTY-NOTICES.TXT')" Text="THIRD-PARTY-NOTICES.TXT was not found in '$(_ShalltearRuntimePack)'. Restore the NativeAOT runtime pack" />
		<Copy SourceFiles="$(_ShalltearRuntimePack)LICENSE.TXT;$(_ShalltearRuntimePack)THIRD-PARTY-NOTICES.TXT" DestinationFolder="$(PublishDir)notices" SkipUnchangedFiles="true" />
	</Target>

	<Target Name="ShalltearUseBundledLinker" BeforeTargets="LinkNative" Condition="'$(ShalltearBundledLinker)' == 'true'">
		<Error Condition="!Exists('$(ShalltearLinkerDir)lld-link.exe')" Text="lld-link.exe was not found in '$(ShalltearLinkerDir)'. Set ShalltearLinkerDir (or ShalltearWindowsLinker=VisualStudio)" />
		<Error Condition="!Exists('$(ShalltearNativeDir)CRTShim.obj')" Text="CRTShim.obj was not found in '$(ShalltearNativeDir)'. Set ShalltearNativeDir" />
		<PropertyGroup>
			<CppLinker>$(ShalltearLinkerDir)lld-link.exe</CppLinker>
		</PropertyGroup>
		<ItemGroup>
			<LinkerArg Include="/LIBPATH:&quot;$(ShalltearNativeDir)libs&quot;" />
			<LinkerArg Include="/NODEFAULTLIB" />
			<LinkerArg Include="ucrt.lib" />
			<LinkerArg Include="clang_rt.builtins-x86_64.lib" />
			<LinkerArg Include="&quot;$(ShalltearNativeDir)CRTShim.obj&quot;" />
			<LinkerArg Include="/Brepro" />
		</ItemGroup>
	</Target>
</Project>
