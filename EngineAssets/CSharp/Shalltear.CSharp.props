<Project>
	<PropertyGroup>
		<TargetFramework>$(ShalltearTargetFramework)</TargetFramework>
		<OutputType>Library</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<IsAotCompatible>true</IsAotCompatible>
		<InvariantGlobalization>$(ShalltearInvariantGlobalization)</InvariantGlobalization>
		<AllowUnsafeBlocks>$(ShalltearAllowUnsafeBlocks)</AllowUnsafeBlocks>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Deterministic>true</Deterministic>
		<DebugType>portable</DebugType>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<RestoreAdditionalProjectFallbackFolders Condition="Exists('$(ShalltearPackagesRoot)')">$(RestoreAdditionalProjectFallbackFolders);$(ShalltearPackagesRoot)</RestoreAdditionalProjectFallbackFolders>
	</PropertyGroup>
	<PropertyGroup Condition="'$(ShalltearPlayerScripts)' == 'true'">
		<DefineConstants>$(DefineConstants);SHALLTEAR_PLAYER</DefineConstants>
		<PathMap>$([System.IO.Path]::GetFullPath('$(ShalltearBuildRoot)'))=./Library/,$(MSBuildProjectDirectory)=.</PathMap>
		<ShalltearScriptNames Condition="'$(Configuration)' == 'Release'">hashed</ShalltearScriptNames>
	</PropertyGroup>
	<PropertyGroup Condition="'$(ShalltearAOTAnalysis)' == 'false'">
		<EnableTrimAnalyzer>false</EnableTrimAnalyzer>
		<EnableAotAnalyzer>false</EnableAotAnalyzer>
		<EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
	</PropertyGroup>
	<ItemGroup>
		<CompilerVisibleProperty Include="MSBuildProjectDirectory" />
		<CompilerVisibleProperty Include="ShalltearScriptNames" />
		<Reference Include="Shalltear.Runtime" HintPath="$(ShalltearManagedDir)Shalltear.Runtime.dll" Private="false" />
		<Analyzer Include="$(ShalltearManagedDir)Shalltear.Generators.dll" />
	</ItemGroup>
</Project>
