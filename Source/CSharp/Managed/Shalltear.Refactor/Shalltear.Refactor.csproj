<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>$(ShalltearTargetFramework)</TargetFramework>
		<RuntimeFrameworkVersion>$(ShalltearRuntimeVersion)</RuntimeFrameworkVersion>
		<RollForward>Disable</RollForward>
		<UseAppHost>false</UseAppHost>
		<InvariantGlobalization>true</InvariantGlobalization>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<OutDir>$(ShalltearManagedOutput)Refactor/</OutDir>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(ShalltearRoslynVersion)" />
	</ItemGroup>
</Project>
