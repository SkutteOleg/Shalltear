<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>$(ShalltearTargetFramework)</TargetFramework>
		<RootNamespace>Shalltear.Conformance</RootNamespace>
		<IsAotCompatible>true</IsAotCompatible>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NoWarn>$(NoWarn);CA2255</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="../Shalltear.Conformance/Check.cs" Link="Check.cs" />
		<InternalsVisibleTo Include="Shalltear.ConformanceAudioAOT" />
		<ProjectReference Include="../Shalltear.Runtime/Shalltear.Runtime.csproj" Private="false" />
		<ProjectReference Include="../Shalltear.Audio/Shalltear.Audio.csproj" Private="false" />
		<ProjectReference Include="../Shalltear.Generators/Shalltear.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>
</Project>
