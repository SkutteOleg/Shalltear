<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>$(ShalltearTargetFramework)</TargetFramework>
		<RootNamespace>Shalltear.Conformance</RootNamespace>
		<IsAotCompatible>true</IsAotCompatible>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NoWarn>$(NoWarn);CA2255</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Shalltear.ConformanceAOT" />
		<ProjectReference Include="../Shalltear.Runtime/Shalltear.Runtime.csproj" Private="false" />
		<ProjectReference Include="../Shalltear.Physics3D/Shalltear.Physics3D.csproj" Private="false" />
		<ProjectReference Include="../Shalltear.Animation/Shalltear.Animation.csproj" Private="false" />
		<ProjectReference Include="../Shalltear.Generators/Shalltear.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>
</Project>
