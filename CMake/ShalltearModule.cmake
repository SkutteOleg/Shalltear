# shalltear_add_module(name [SOURCES files...] [BIND_HEADERS headers...] [BIND_NAMESPACES namespaces...] [EDITOR] [OUTPUT_DIRECTORY dir])

# project's CMakeLists.txt should never name a package
function(_shalltear_enabled_package_targets OUT_TARGETS OUT_ANCHORS)
	set(targets "")
	set(anchors "")
	foreach(packageId ${SHALLTEAR_ENABLED_PACKAGES})
		list(FIND SHALLTEAR_PACKAGE_IDS "${packageId}" packageIndex)
		if(packageIndex EQUAL -1)
			message(FATAL_ERROR
				"this build enables '${packageId}', which this engine build does not carry.\n"
				"  It has: ${SHALLTEAR_PACKAGE_IDS}")
		endif()
		list(GET SHALLTEAR_PACKAGE_TARGETS ${packageIndex} packageTarget)
		list(GET SHALLTEAR_PACKAGE_ANCHORS ${packageIndex} packageAnchor)
		list(APPEND targets "${packageTarget}")
		list(APPEND anchors "${packageAnchor}")
	endforeach()
	set(${OUT_TARGETS} "${targets}" PARENT_SCOPE)
	set(${OUT_ANCHORS} "${anchors}" PARENT_SCOPE)
endfunction()

function(_shalltear_write_package_umbrellas TARGET_NAME LINKED_TARGETS)
	set(umbrellaIncludes "")
	foreach(linkedTarget ${LINKED_TARGETS})
		get_target_property(umbrella ${linkedTarget} SHALLTEAR_UMBRELLA)
		if(umbrella)
			string(APPEND umbrellaIncludes "#include \"${umbrella}\"\n")
		endif()
	endforeach()

	set(generatedDir "${CMAKE_CURRENT_BINARY_DIR}/ShalltearGenerated")
	# rewrites only a changed file
	file(CONFIGURE OUTPUT "${generatedDir}/ShalltearPackages.h" CONTENT
"#pragma once

// GENERATED by shalltear_add_module(). Do not edit manually

// IWYU pragma: begin_exports
@umbrellaIncludes@// IWYU pragma: end_exports
" @ONLY NEWLINE_STYLE LF)
	target_include_directories(${TARGET_NAME} PRIVATE "${generatedDir}")
endfunction()

# package link this build didn't make should be refused
function(_shalltear_refuse_unlisted_packages MODULE_NAME ALLOWED REASON)
	cmake_language(EVAL CODE
		"cmake_language(DEFER CALL _shalltear_check_package_links [==[${MODULE_NAME}]==] [==[${ALLOWED}]==] [==[${SHALLTEAR_PACKAGE_TARGETS}]==] [==[${SHALLTEAR_PACKAGE_IDS}]==] ${REASON})")
endfunction()

function(_shalltear_check_package_links MODULE_NAME ALLOWED PACKAGE_TARGETS PACKAGE_IDS REASON)
	get_target_property(linked ${MODULE_NAME} LINK_LIBRARIES)
	if(NOT linked)
		return()
	endif()
	foreach(item IN LISTS linked)
		if(NOT item IN_LIST PACKAGE_TARGETS OR item IN_LIST ALLOWED)
			continue()
		endif()
		list(FIND PACKAGE_TARGETS "${item}" packageIndex)
		list(GET PACKAGE_IDS ${packageIndex} packageId)
		if(REASON STREQUAL "STATIC")
			message(FATAL_ERROR
				"${MODULE_NAME} links ${item}, but this Shalltear SDK is STATIC!\n"
				"  Fix: point Shalltear_ROOT at the shared SDK.")
		endif()
		message(FATAL_ERROR
			"${MODULE_NAME} links ${item}, but ${packageId} is not enabled in this project.\n"
			"  Packages turned on in the Package Manager are linked automatically. Turn this one on there, or remove ${item} from target_link_libraries in CMakeLists.txt.")
	endforeach()
endfunction()

function(_shalltear_prepare_module_sources MODULE_NAME OUT_SOURCES BIND_HEADERS)
	set(sources ${ARGN})
	if(sources)
		set(${OUT_SOURCES} "${sources}" PARENT_SCOPE)
		return()
	endif()
	if(NOT BIND_HEADERS)
		message(FATAL_ERROR "shalltear_add_module(${MODULE_NAME}): provide SOURCES or BIND_HEADERS.")
	endif()
	set(generatedDir "${CMAKE_CURRENT_BINARY_DIR}/ShalltearGenerated")
	set(entryFile "${generatedDir}/${MODULE_NAME}ModuleEntry.generated.cpp")
	file(CONFIGURE OUTPUT "${entryFile}" CONTENT
"// GENERATED by shalltear_add_module(). Do not edit manually.

#include \"Shalltear.h\"

SLT_IMPLEMENT_MODULE(@MODULE_NAME@)
" @ONLY NEWLINE_STYLE LF)
	set(${OUT_SOURCES} "${entryFile}" PARENT_SCOPE)
endfunction()

function(_shalltear_find_header_binder_tools OUT_BINDER OUT_LIBCLANG OUT_DOTNET_EXE OUT_DOTNET_ROOT)
	set(binderDll "")
	set(binderCandidates
		"${SHALLTEAR_HEADER_BINDER_DLL}"
		"${SHALLTEAR_RUNTIME_DIR}/CSharp/HeaderBinder/Shalltear.HeaderBinder.dll"
		"${SHALLTEAR_PACKAGE_ROOT}/CSharp/HeaderBinder/Shalltear.HeaderBinder.dll"
		"${SHALLTEAR_PACKAGE_ROOT}/../CSharp/HeaderBinder/Shalltear.HeaderBinder.dll"
		"${SHALLTEAR_PACKAGE_ROOT}/../bin/CSharp/HeaderBinder/Shalltear.HeaderBinder.dll"
		"${SHALLTEAR_PACKAGE_ROOT}/../../CSharp/HeaderBinder/Shalltear.HeaderBinder.dll")
	foreach(candidate IN LISTS binderCandidates)
		if(candidate AND EXISTS "${candidate}")
			get_filename_component(binderDll "${candidate}" ABSOLUTE)
			break()
		endif()
	endforeach()

	set(libclangDir "")
	set(libclangCandidates
		"${SHALLTEAR_LIBCLANG_DIR}"
		"${SHALLTEAR_PACKAGE_ROOT}/Toolchain/libclang/bin"
		"${SHALLTEAR_PACKAGE_ROOT}/../Toolchain/libclang/bin"
		"${SHALLTEAR_PACKAGE_ROOT}/../../Toolchain/libclang/bin"
		"${SHALLTEAR_PACKAGE_ROOT}/Toolchain/libclang/lib"
		"${SHALLTEAR_PACKAGE_ROOT}/../Toolchain/libclang/lib"
		"${SHALLTEAR_PACKAGE_ROOT}/../../Toolchain/libclang/lib")
	if(SHALLTEAR_ENGINE_SOURCE_DIR)
		list(APPEND libclangCandidates
			"${SHALLTEAR_ENGINE_SOURCE_DIR}/External/Prebuilt/libclang/bin"
			"${SHALLTEAR_ENGINE_SOURCE_DIR}/External/Prebuilt/libclang/lib")
	endif()
	foreach(candidate IN LISTS libclangCandidates)
		if(NOT candidate OR NOT IS_DIRECTORY "${candidate}")
			continue()
		endif()
		if(CMAKE_HOST_WIN32)
			if(EXISTS "${candidate}/libclang.dll")
				get_filename_component(libclangDir "${candidate}" ABSOLUTE)
				break()
			endif()
		else()
			file(GLOB clangLibs "${candidate}/libclang.so*")
			if(clangLibs)
				get_filename_component(libclangDir "${candidate}" ABSOLUTE)
				break()
			endif()
		endif()
	endforeach()

	if(CMAKE_HOST_WIN32)
		set(dotnetBin "dotnet.exe")
	else()
		set(dotnetBin "dotnet")
	endif()

	set(dotnetRoot "")
	set(dotnetExe "")
	set(dotnetRoots
		"${SHALLTEAR_DOTNET_ROOT}"
		"$ENV{DOTNET_ROOT}"
		"${SHALLTEAR_PACKAGE_ROOT}/Toolchain/DotNet"
		"${SHALLTEAR_PACKAGE_ROOT}/../Toolchain/DotNet"
		"${SHALLTEAR_PACKAGE_ROOT}/../../Toolchain/DotNet")
	if(SHALLTEAR_ENGINE_SOURCE_DIR)
		file(GLOB engineDotnetDirs "${SHALLTEAR_ENGINE_SOURCE_DIR}/External/Prebuilt/dotnet/*")
		list(SORT engineDotnetDirs ORDER DESCENDING)
		list(APPEND dotnetRoots ${engineDotnetDirs})
	endif()
	if(CMAKE_HOST_WIN32 AND DEFINED ENV{LOCALAPPDATA})
		file(GLOB cacheDotnetDirs "$ENV{LOCALAPPDATA}/Shalltear/dotnet/*")
		list(SORT cacheDotnetDirs ORDER DESCENDING)
		list(APPEND dotnetRoots ${cacheDotnetDirs})
	else()
		if(DEFINED ENV{XDG_DATA_HOME})
			file(GLOB cacheDotnetDirs "$ENV{XDG_DATA_HOME}/Shalltear/dotnet/*")
			list(SORT cacheDotnetDirs ORDER DESCENDING)
			list(APPEND dotnetRoots ${cacheDotnetDirs})
		endif()
		if(DEFINED ENV{HOME})
			file(GLOB homeDotnetDirs "$ENV{HOME}/.local/share/Shalltear/dotnet/*")
			list(SORT homeDotnetDirs ORDER DESCENDING)
			list(APPEND dotnetRoots ${homeDotnetDirs})
		endif()
	endif()
	foreach(rootCandidate IN LISTS dotnetRoots)
		if(rootCandidate AND EXISTS "${rootCandidate}/${dotnetBin}")
			get_filename_component(dotnetRoot "${rootCandidate}" ABSOLUTE)
			set(dotnetExe "${dotnetRoot}/${dotnetBin}")
			break()
		endif()
	endforeach()
	if(NOT dotnetExe)
		find_program(foundDotnet NAMES dotnet NO_CACHE)
		if(foundDotnet)
			set(dotnetExe "${foundDotnet}")
			get_filename_component(dotnetRoot "${foundDotnet}" DIRECTORY)
		endif()
	endif()

	set(${OUT_BINDER} "${binderDll}" PARENT_SCOPE)
	set(${OUT_LIBCLANG} "${libclangDir}" PARENT_SCOPE)
	set(${OUT_DOTNET_EXE} "${dotnetExe}" PARENT_SCOPE)
	set(${OUT_DOTNET_ROOT} "${dotnetRoot}" PARENT_SCOPE)
endfunction()

function(_shalltear_finalize_header_bindings MODULE_NAME PROJECT_ROOT BINDER_DLL LIBCLANG_DIR DOTNET_EXE DOTNET_ROOT EXPLICIT_HEADERS AUTO_HEADERS NAMESPACES)
	set(generatedDir "${CMAKE_CURRENT_BINARY_DIR}/ShalltearGenerated")
	set(outCpp "${generatedDir}/UserThunks.generated.cpp")
	set(outCs "${PROJECT_ROOT}/Library/CSharp/Generated/Native/UserBindings.g.cs")
	set(rspFile "${generatedDir}/HeaderBinder.rsp")
	set(policyFile "${PROJECT_ROOT}/ExposurePolicy.json")

	set(rspContent "")
	string(APPEND rspContent "--module=${MODULE_NAME}\n")
	string(APPEND rspContent "--libclang-dir=${LIBCLANG_DIR}\n")
	string(APPEND rspContent "--out-cpp=${outCpp}\n")
	string(APPEND rspContent "--out-cs=${outCs}\n")
	foreach(header IN LISTS EXPLICIT_HEADERS)
		string(APPEND rspContent "--explicit-header=${header}\n")
	endforeach()
	foreach(header IN LISTS AUTO_HEADERS)
		string(APPEND rspContent "--header=${header}\n")
	endforeach()
	set(extraDepends "")
	if(EXISTS "${policyFile}")
		string(APPEND rspContent "--policy=${policyFile}\n")
		list(APPEND extraDepends "${policyFile}")
	endif()
	foreach(ns IN LISTS NAMESPACES)
		string(APPEND rspContent "--namespace=${ns}\n")
	endforeach()
	string(APPEND rspContent "--include=$<JOIN:$<TARGET_PROPERTY:${MODULE_NAME},INCLUDE_DIRECTORIES>,;>\n")
	string(APPEND rspContent "--define=$<JOIN:$<TARGET_PROPERTY:${MODULE_NAME},COMPILE_DEFINITIONS>,;>\n")

	get_filename_component(toolchainBin "${CMAKE_CXX_COMPILER}" DIRECTORY)
	get_filename_component(toolchainRoot "${toolchainBin}" DIRECTORY)
	file(GLOB clangResourceDirs "${toolchainRoot}/lib/clang/*/include")
	list(SORT clangResourceDirs ORDER DESCENDING)

	if(MINGW)
		string(APPEND rspContent "--clang-arg=--target=x86_64-w64-mingw32\n")
		if(IS_DIRECTORY "${toolchainRoot}/include/c++/v1")
			string(APPEND rspContent "--clang-arg=-isystem\n--clang-arg=${toolchainRoot}/include/c++/v1\n")
		endif()
		if(clangResourceDirs)
			list(GET clangResourceDirs 0 clangResInclude)
			string(APPEND rspContent "--clang-arg=-isystem\n--clang-arg=${clangResInclude}\n")
		endif()
		if(IS_DIRECTORY "${toolchainRoot}/include")
			string(APPEND rspContent "--clang-arg=-isystem\n--clang-arg=${toolchainRoot}/include\n")
		endif()
		if(IS_DIRECTORY "${toolchainRoot}/x86_64-w64-mingw32/include")
			string(APPEND rspContent "--clang-arg=-isystem\n--clang-arg=${toolchainRoot}/x86_64-w64-mingw32/include\n")
		endif()
	elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
		string(APPEND rspContent "--clang-arg=--target=x86_64-unknown-linux-gnu\n")
		if(CMAKE_SYSROOT)
			string(APPEND rspContent "--sysroot=${CMAKE_SYSROOT}\n")
		endif()
		if(IS_DIRECTORY "${toolchainRoot}/include/c++/v1")
			string(APPEND rspContent "--clang-arg=-isystem\n--clang-arg=${toolchainRoot}/include/c++/v1\n")
		endif()
		if(clangResourceDirs)
			list(GET clangResourceDirs 0 clangResInclude)
			string(APPEND rspContent "--clang-arg=-isystem\n--clang-arg=${clangResInclude}\n")
		endif()
	endif()

	file(GENERATE OUTPUT "${rspFile}" CONTENT "${rspContent}")

	add_custom_command(
		OUTPUT "${outCpp}"
		COMMAND ${CMAKE_COMMAND} -E env
			"DOTNET_ROOT=${DOTNET_ROOT}"
			DOTNET_CLI_TELEMETRY_OPTOUT=1
			DOTNET_NOLOGO=1
			DOTNET_MULTILEVEL_LOOKUP=0
			"${DOTNET_EXE}" "${BINDER_DLL}" --args-file "${rspFile}"
		DEPENDS ${EXPLICIT_HEADERS} ${AUTO_HEADERS} ${extraDepends} "${BINDER_DLL}" "${rspFile}"
		COMMENT "Generating C# bindings for ${MODULE_NAME} headers"
		VERBATIM)

	target_sources(${MODULE_NAME} PRIVATE "${outCpp}")
	set_source_files_properties("${outCpp}" PROPERTIES SKIP_PRECOMPILE_HEADERS ON)
endfunction()

function(_shalltear_attach_header_bindings MODULE_NAME PROJECT_ROOT BIND_HEADERS BIND_NAMESPACES)
	target_include_directories(${MODULE_NAME} PRIVATE "${PROJECT_ROOT}/Library/CSharp/Generated/Views")

	set(csharpEnabled FALSE)
	if(DEFINED SHALLTEAR_ENABLED_PACKAGES)
		if("dev.shalltear.csharp" IN_LIST SHALLTEAR_ENABLED_PACKAGES)
			set(csharpEnabled TRUE)
		else()
			return()
		endif()
	endif()

	set(explicitHeaders "")
	foreach(header IN LISTS BIND_HEADERS)
		if(IS_ABSOLUTE "${header}")
			get_filename_component(resolvedHeader "${header}" ABSOLUTE)
		else()
			get_filename_component(resolvedHeader "${CMAKE_CURRENT_SOURCE_DIR}/${header}" ABSOLUTE)
		endif()
		if(NOT resolvedHeader IN_LIST explicitHeaders)
			list(APPEND explicitHeaders "${resolvedHeader}")
		endif()
	endforeach()

	set(autoHeaders "")
	if((csharpEnabled OR BIND_HEADERS) AND IS_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/Source")
		file(GLOB_RECURSE sourceHeaders CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/Source/*.h")
		list(SORT sourceHeaders)
		foreach(header IN LISTS sourceHeaders)
			if(header MATCHES "/Private/" OR header MATCHES "/ThirdParty/" OR header MATCHES "\\.generated\\.h$")
				continue()
			endif()
			if(NOT header IN_LIST explicitHeaders AND NOT header IN_LIST autoHeaders)
				list(APPEND autoHeaders "${header}")
			endif()
		endforeach()
	endif()

	if(NOT explicitHeaders AND NOT autoHeaders)
		return()
	endif()

	_shalltear_find_header_binder_tools(binderDll libclangDir dotnetExe dotnetRoot)
	if(NOT binderDll OR NOT libclangDir OR NOT dotnetExe)
		if(BIND_HEADERS OR csharpEnabled)
			message(FATAL_ERROR
				"shalltear_add_module(${MODULE_NAME}): C# header binding requires Shalltear.HeaderBinder.dll, libclang, and dotnet.\n"
				"  HeaderBinder: '${binderDll}'\n"
				"  libclang dir: '${libclangDir}'\n"
				"  dotnet:       '${dotnetExe}'")
		endif()
		return()
	endif()

	cmake_language(EVAL CODE
		"cmake_language(DEFER CALL _shalltear_finalize_header_bindings [==[${MODULE_NAME}]==] [==[${PROJECT_ROOT}]==] [==[${binderDll}]==] [==[${libclangDir}]==] [==[${dotnetExe}]==] [==[${dotnetRoot}]==] [==[${explicitHeaders}]==] [==[${autoHeaders}]==] [==[${BIND_NAMESPACES}]==])")
endfunction()

function(shalltear_add_module MODULE_NAME)
	cmake_parse_arguments(SLT_MODULE "EDITOR" "OUTPUT_DIRECTORY" "SOURCES;BIND_HEADERS;BIND_NAMESPACES" ${ARGN})

	if(SHALLTEAR_PLAYER_TARGET)
		_shalltear_add_player_impl(${MODULE_NAME} ${ARGN})
		return()
	endif()

	_shalltear_prepare_module_sources(${MODULE_NAME} moduleSources "${SLT_MODULE_BIND_HEADERS}" ${SLT_MODULE_SOURCES})

	shalltear_enforce_toolchain(${MODULE_NAME})
	# module built against another commit's headers should be refused
	shalltear_enforce_engine_identity(${MODULE_NAME})

	add_library(${MODULE_NAME} SHARED ${moduleSources})
	target_link_libraries(${MODULE_NAME} PRIVATE Shalltear::Core)
	set_target_properties(${MODULE_NAME} PROPERTIES
		CXX_STANDARD 20
		CXX_STANDARD_REQUIRED ON
		PREFIX ""
		IMPORT_PREFIX "")

	if(SHALLTEAR_LINK_MODE STREQUAL "SHARED")
		target_compile_definitions(${MODULE_NAME} PRIVATE SHALLTEAR_SHARED)
	endif()

	set(linkedPackageTargets "")
	if(NOT SHALLTEAR_LINK_MODE STREQUAL "SHARED")
		_shalltear_refuse_unlisted_packages(${MODULE_NAME} "" STATIC)
	elseif(DEFINED SHALLTEAR_ENABLED_PACKAGES)
		_shalltear_enabled_package_targets(linkedPackageTargets enabledAnchors)
		target_link_libraries(${MODULE_NAME} PRIVATE ${linkedPackageTargets})
		_shalltear_refuse_unlisted_packages(${MODULE_NAME} "${linkedPackageTargets}" DISABLED)
	else()
		message(STATUS "shalltear_add_module(${MODULE_NAME}): SHALLTEAR_ENABLED_PACKAGES is not set, no package is linked. The editor and its generated presets set it.")
	endif()
	_shalltear_write_package_umbrellas(${MODULE_NAME} "${linkedPackageTargets}")

	# user never names the precompiled header
	target_precompile_headers(${MODULE_NAME} PRIVATE
		[[$<$<COMPILE_LANGUAGE:CXX>:"Shalltear.h">]])

	if(SLT_MODULE_EDITOR)
		# module editor extensions are shared link only
		if(NOT SHALLTEAR_LINK_MODE STREQUAL "SHARED")
			message(FATAL_ERROR
				"shalltear_add_module(${MODULE_NAME} EDITOR): module editor extensions require the SHARED Shalltear SDK, "
				"but this one is ${SHALLTEAR_LINK_MODE}.\n"
				"  Fix: point Shalltear_ROOT at the shared SDK (or drop the EDITOR option).")
		endif()
		target_link_libraries(${MODULE_NAME} PRIVATE Shalltear::Editor)
		target_compile_definitions(${MODULE_NAME} PRIVATE SLT_WITH_EDITOR)
	endif()

	if(SHALLTEAR_PROJECT_ROOT)
		set(projectRoot "${SHALLTEAR_PROJECT_ROOT}")
	else()
		set(projectRoot "${CMAKE_CURRENT_SOURCE_DIR}")
	endif()

	# not CMAKE_SOURCE_DIR (breaks under add_subdirectory)
	if(SLT_MODULE_OUTPUT_DIRECTORY)
		set(moduleOutputRoot "${SLT_MODULE_OUTPUT_DIRECTORY}")
	else()
		set(moduleOutputRoot "${projectRoot}/Library/Binaries")
	endif()

	_shalltear_attach_header_bindings(${MODULE_NAME} "${projectRoot}" "${SLT_MODULE_BIND_HEADERS}" "${SLT_MODULE_BIND_NAMESPACES}")

	if(CMAKE_CONFIGURATION_TYPES)
		set_target_properties(${MODULE_NAME} PROPERTIES
			RUNTIME_OUTPUT_DIRECTORY "${moduleOutputRoot}/$<CONFIG>"
			LIBRARY_OUTPUT_DIRECTORY "${moduleOutputRoot}/$<CONFIG>")
	else()
		if(CMAKE_BUILD_TYPE)
			set(moduleConfig "${CMAKE_BUILD_TYPE}")
		else()
			set(moduleConfig "Debug")
		endif()
		set_target_properties(${MODULE_NAME} PROPERTIES
			RUNTIME_OUTPUT_DIRECTORY "${moduleOutputRoot}/${moduleConfig}"
			LIBRARY_OUTPUT_DIRECTORY "${moduleOutputRoot}/${moduleConfig}")
	endif()

	add_custom_target(${MODULE_NAME}_ShalltearCompileStamp ALL
		COMMAND ${CMAKE_COMMAND} -E touch "$<TARGET_FILE_DIR:${MODULE_NAME}>/${MODULE_NAME}.compiled"
		VERBATIM)
	add_dependencies(${MODULE_NAME}_ShalltearCompileStamp ${MODULE_NAME})

	_shalltear_write_build_stamp(${MODULE_NAME} FALSE)

	if(WIN32)
		target_compile_options(${MODULE_NAME} PRIVATE -g -gcodeview)
	else()
		target_compile_options(${MODULE_NAME} PRIVATE -g)
		set_target_properties(${MODULE_NAME} PROPERTIES
			C_VISIBILITY_PRESET hidden CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON)
	endif()
	if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
		# unused package should not become an import (shitty ELF default)
		target_link_options(${MODULE_NAME} PRIVATE -Wl,--no-undefined -Wl,--as-needed)
	endif()
	if(MINGW)
		target_link_options(${MODULE_NAME} PRIVATE -g -Wl,--pdb=)
	else()
		target_link_options(${MODULE_NAME} PRIVATE -g)
	endif()

	target_compile_options(${MODULE_NAME} PRIVATE -fdiagnostics-absolute-paths)

	set_target_properties(${MODULE_NAME} PROPERTIES EXPORT_COMPILE_COMMANDS ON)
endfunction()
