<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>$(ShalltearTargetFramework)</TargetFramework>
		<RootNamespace>Shalltear.Generated</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ShalltearPlayerBuild>true</ShalltearPlayerBuild>
		<ShalltearRenameScripts>true</ShalltearRenameScripts>
		<ShalltearRenamerPath>$(ShalltearManagedOutput)Renamer/Shalltear.Renamer.dll</ShalltearRenamerPath>
		<OutDir>$(ShalltearManagedRoot)aot/</OutDir>
		<RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
	</PropertyGroup>
	<ItemGroup>
		<Reference Include="Shalltear.Runtime" HintPath="$(ShalltearManagedOutput)Shalltear.Runtime.dll" />
		<Reference Include="Shalltear.Physics3D" HintPath="$(ShalltearManagedOutput)Shalltear.Physics3D.dll" />
		<Reference Include="Shalltear.Animation" HintPath="$(ShalltearManagedOutput)Shalltear.Animation.dll" />
		<Reference Include="Shalltear.Conformance" HintPath="$(ShalltearManagedOutput)Shalltear.Conformance.dll" />
		<ShalltearRenameAssembly Include="Shalltear.Conformance" />
	</ItemGroup>
	<Import Project="$(ShalltearRepoRoot)EngineAssets/CSharp/Shalltear.CSharp.targets" />
	<Target Name="ShalltearAddLinkMap" BeforeTargets="LinkNative" Condition="$(RuntimeIdentifier.StartsWith('win'))">
		<ItemGroup>
			<LinkerArg Include="/MAP:&quot;$(NativeIntermediateOutputPath)$(TargetName).map&quot;" />
		</ItemGroup>
	</Target>
</Project>
